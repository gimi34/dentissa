{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/socialite": "^5.28",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-24ph-xkrh-y79j": "EX4 en docs/security.md, vence el 2026-11-11: corregido en Symfony 7.4.23, que aun no cumple los 7 dias de antiguedad",
                "PKSA-pr6q-2w5s-kzzf": "EX4 en docs/security.md, vence el 2026-11-11: corregido en Symfony 7.4.23, que aun no cumple los 7 dias de antiguedad",
                "PKSA-nxjs-s6hn-vb6m": "EX4 en docs/security.md, vence el 2026-11-11: corregido en Symfony 7.4.23, que aun no cumple los 7 dias de antiguedad",
                "PKSA-b2gg-vk1g-6d5q": "EX4 en docs/security.md, vence el 2026-11-11: corregido en Symfony 7.4.23, que aun no cumple los 7 dias de antiguedad",
                "PKSA-3gxv-7xhq-mgmz": "EX4 en docs/security.md, vence el 2026-11-11: corregido en Symfony 7.4.23, que aun no cumple los 7 dias de antiguedad",
                "PKSA-y8c5-1b7f-r1gj": "EX4 en docs/security.md, vence el 2026-11-11: corregido en Symfony 7.4.23, que aun no cumple los 7 dias de antiguedad"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
